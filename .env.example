# RITW Dynamic CMS Environment Configuration
PORT=5000
NODE_ENV=development

# JWT Secret - generate a secure 64-char hex string in production
JWT_SECRET=ritw_engineering_college_secure_jwt_token_key_2026_super_secret
JWT_EXPIRES_IN=2h

# Initial Administrator Credentials (can also be provisioned via: node cli.js init-admin <user> <pass>)
ADMIN_INITIAL_USER=admin
ADMIN_INITIAL_PASS=RitwAdmin@2026!

# Database Path
DB_PATH=server/db/ritw_cms.sqlite
